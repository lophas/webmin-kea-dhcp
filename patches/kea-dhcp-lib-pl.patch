 # kea_active_leases(version)
 # Returns active leases for a DHCP version, preserving file/error context.
+# kea_live_leases(version)
+# Reads the current lease database directly from the running Kea server
+# through its control socket and lease_cmds hook.
+sub kea_live_leases
+{
+my ($ver) = @_;
+
+# This installation currently runs DHCPv4 only.
+return ([ ], undef, "live") if ($ver != 4);
+
+my $socket_path = "/run/kea/kea4-ctrl-socket";
+
+eval {
+	require IO::Socket::UNIX;
+	require JSON::PP;
+	require Socket;
+	};
+
+if ($@) {
+	return ([ ], "Cannot load Perl socket/JSON modules: $@", "live");
+	}
+
+if (!-S $socket_path) {
+	return ([ ], "Kea control socket not found: $socket_path", "live");
+	}
+
+my $sock = IO::Socket::UNIX->new(
+	Type => Socket::SOCK_STREAM(),
+	Peer => $socket_path,
+	);
+
+if (!$sock) {
+	return ([ ], "Cannot connect to Kea control socket $socket_path: $!", "live");
+	}
+
+my $request = {
+	'command' => 'lease4-get-all',
+	};
+
+my $json = JSON::PP->new->utf8->canonical;
+my $payload = $json->encode($request) . "\n";
+
+my $written = syswrite($sock, $payload);
+if (!defined($written)) {
+	close($sock);
+	return ([ ], "Cannot write to Kea control socket: $!", "live");
+	}
+
+shutdown($sock, 1);
+
+my $reply = "";
+my $buf;
+
+while (1) {
+	my $n = sysread($sock, $buf, 65536);
+	if (!defined($n)) {
+		close($sock);
+		return ([ ], "Cannot read from Kea control socket: $!", "live");
+		}
+	last if ($n == 0);
+	$reply .= substr($buf, 0, $n);
+	}
+
+close($sock);
+
+my $data;
+eval {
+	$data = $json->decode($reply);
+	};
+
+if ($@) {
+	return ([ ], "Invalid JSON received from Kea: $@", "live");
+	}
+
+# Direct Kea control-socket responses are normally hashes.
+# Accept a one-element array too, to be tolerant of alternate transports.
+if (ref($data) eq 'ARRAY') {
+	$data = $data->[0];
+	}
+
+if (ref($data) ne 'HASH') {
+	return ([ ], "Unexpected Kea control response", "live");
+	}
+
+if (($data->{'result'} // 1) != 0) {
+	return ([ ], $data->{'text'} || "Kea lease query failed", "live");
+	}
+
+my $leases =
+	ref($data->{'arguments'}) eq 'HASH' &&
+	ref($data->{'arguments'}->{'leases'}) eq 'ARRAY' ?
+		$data->{'arguments'}->{'leases'} : [ ];
+
+return ($leases, undef, "live");
+}
+
+# kea_current_leases(version)
+# Returns the lease database currently held by the running Kea server.
+sub kea_current_leases
+{
+my ($ver) = @_;
+return &kea_live_leases($ver);
+}
+
