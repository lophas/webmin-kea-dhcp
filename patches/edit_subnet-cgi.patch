 my ($reservations, $ver) = @_;
 $reservations = [ ] if (ref($reservations) ne 'ARRAY');
 
+# Display DHCPv4 reservations in numeric IPv4 order without changing
+# the underlying Kea configuration order.
+if ($ver == 4) {
+	my @sorted = sort {
+		my @aa = split(/\./, $a->{'ip-address'} || "");
+		my @bb = split(/\./, $b->{'ip-address'} || "");
+
+		my $cmp = 0;
+		for my $i (0 .. 3) {
+			my $av = defined($aa[$i]) && $aa[$i] =~ /^\d+$/ ? $aa[$i] : -1;
+			my $bv = defined($bb[$i]) && $bb[$i] =~ /^\d+$/ ? $bb[$i] : -1;
+
+			$cmp = $av <=> $bv;
+			last if ($cmp);
+			}
+		$cmp;
+		} @$reservations;
+
+	$reservations = \@sorted;
+	}
+
 # Kea accepts different reservation identifiers per protocol; the dropdown is
