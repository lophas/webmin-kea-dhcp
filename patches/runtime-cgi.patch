+# print_reserved_addresses(version)
+# Shows every configured reservation, independently of lease lifetime.
+sub print_reserved_addresses
+{
+my ($ver) = @_;
+
+my ($leases, $err) = &kea_current_leases($ver);
+my $reservations = &kea_runtime_all_reservations($ver);
+
+print &ui_subheading(&text('comp_dhcp'.$ver));
+&print_lease_error_notice($err);
+return if ($err);
+
+my %lease_by_addr;
+foreach my $lease (@$leases) {
+	my $addr = &kea_lease_address($lease);
+	$lease_by_addr{$addr} = $lease if ($addr);
+	}
+
+my @rows;
+
+foreach my $r (@$reservations) {
+	my $addr = &kea_runtime_reservation_address($r);
+	next if (!$addr);
+
+	my $lease = $lease_by_addr{$addr};
+	my $active = $lease && &kea_lease_is_active($lease);
+
+	push(@rows, {
+		'address' => $addr,
+		'id' => $r->{'_subnet_id'} || "",
+		'identifier' => &kea_runtime_reservation_identifier($r),
+		'hostname' => $r->{'hostname'} ||
+			      ($lease ? ($lease->{'hostname'} || "") : ""),
+		'status' => $active ? "Active lease" : "No active lease",
+		'expires' => $active ? &kea_lease_expires($lease) : "",
+		});
+	}
+
+@rows = sort {
+	&kea_runtime_ip_compare($a->{'address'}, $b->{'address'})
+	} @rows;
+
+print &ui_columns_start([
+	"Address",
+	"ID",
+	"Identifier",
+	"Hostname",
+	"Status",
+	"Expires",
+	], 100);
+
+foreach my $row (@rows) {
+	print &ui_columns_row([
+		&html_escape($row->{'address'}),
+		&html_escape($row->{'id'}),
+		&html_escape($row->{'identifier'}),
+		&html_escape($row->{'hostname'}),
+		&html_escape($row->{'status'}),
+		&html_escape($row->{'expires'}),
+		]);
+	}
+
+print &ui_columns_end();
+}
