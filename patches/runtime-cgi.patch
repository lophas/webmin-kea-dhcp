+# kea_runtime_reservation_map(version)
+# Builds a lookup table of configured reservations for the runtime lease view.
+# DHCPv4 hardware-address reservations are matched using both IP and MAC,
+# avoiding false "Reserved" labels when an address is reused by another client.
+sub kea_runtime_reservation_map
+{
+my ($ver) = @_;
+my (undef, $root, undef, $err) = &kea_read_dhcp_config($ver);
+return { } if ($err || !$root);
+
+my %reserved;
+foreach my $entry (&kea_all_subnets($root, $ver)) {
+	my $subnet = $entry->{'subnet'};
+	next if (ref($subnet->{'reservations'}) ne 'ARRAY');
+
+	foreach my $r (@{$subnet->{'reservations'}}) {
+		my $ip = $r->{'ip-address'} || $r->{'ip_address'} ||
+			 $r->{'prefix'} || "";
+		next if ($ip eq '');
+
+		my $hw = lc($r->{'hw-address'} || $r->{'hw_address'} || "");
+		$hw =~ s/^\s+|\s+$//g;
+
+		if ($hw ne '') {
+			$reserved{"hw|".$ip."|".$hw} = 1;
+			}
+		else {
+			# Keep address-only knowledge for reservation types for which
+			# the lease CSV does not expose a directly comparable identifier.
+			$reserved{"ip|".$ip} = 1;
+			}
+		}
+	}
+return \%reserved;
+}
+
+# kea_runtime_lease_type(&lease, &reservation_map, version)
+# Labels an active lease as Reserved when it matches a configured reservation.
+sub kea_runtime_lease_type
+{
+my ($lease, $reserved, $ver) = @_;
+my $ip = &kea_lease_address($lease);
+my $hw = lc(
+	$lease->{'hw-address'} ||
+	$lease->{'hwaddr'} ||
+	$lease->{'hw_address'} ||
+	""
+);
+$hw =~ s/^\s+|\s+$//g;
+
+return "Reserved"
+	if ($ip ne '' && $hw ne '' &&
+	    $reserved->{"hw|".$ip."|".$hw});
+
+return "Reserved"
+	if ($ip ne '' && $reserved->{"ip|".$ip});
+
+return "Dynamic";
+}
+
+
+# kea_runtime_all_reservations(version)
+# Returns configured reservation rows with their subnet IDs.
+sub kea_runtime_all_reservations
+{
+my ($ver) = @_;
+my (undef, $root, undef, $err) = &kea_read_dhcp_config($ver);
+return [ ] if ($err || !$root);
+
+my @rows;
+
+foreach my $entry (&kea_all_subnets($root, $ver)) {
+	my $subnet = $entry->{'subnet'};
+	my $sid = $subnet->{'id'} || "";
+
+	next if (ref($subnet->{'reservations'}) ne 'ARRAY');
+
+	foreach my $r (@{$subnet->{'reservations'}}) {
+		my %copy = %$r;
+		$copy{'_subnet_id'} = $sid;
+		push(@rows, \%copy);
+		}
+	}
+
+return \@rows;
+}
+
+# kea_runtime_reservation_identifier(reservation)
+sub kea_runtime_reservation_identifier
+{
+my ($r) = @_;
+
+return $r->{'hw-address'} ||
+       $r->{'hw_address'} ||
+       $r->{'client-id'} ||
+       $r->{'client_id'} ||
+       $r->{'duid'} ||
+       $r->{'flex-id'} ||
+       "";
+}
+
+# kea_runtime_reservation_address(reservation)
+sub kea_runtime_reservation_address
+{
+my ($r) = @_;
+
+return $r->{'ip-address'} ||
+       $r->{'ip_address'} ||
+       $r->{'prefix'} ||
+       "";
+}
+
+# kea_runtime_ip_sort(&a, &b)
+# Numeric IPv4 sorting, textual fallback for non-IPv4 values.
+sub kea_runtime_ip_compare
+{
+my ($aa, $bb) = @_;
+
+my @a = split(/\./, $aa || "");
+my @b = split(/\./, $bb || "");
+
+if (@a == 4 && @b == 4 &&
+    !grep { $_ !~ /^\d+$/ } (@a, @b)) {
+	return
+		$a[0] <=> $b[0] ||
+		$a[1] <=> $b[1] ||
+		$a[2] <=> $b[2] ||
+		$a[3] <=> $b[3];
+	}
+
+return ($aa || "") cmp ($bb || "");
+}
