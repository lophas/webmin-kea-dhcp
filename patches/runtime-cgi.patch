+# Normalizes an identifier when it is a normal MAC address.
+sub kea_runtime_mac_from_identifier
+{
+my ($id) = @_;
+my $mac = lc($id || "");
+$mac =~ s/^\s+|\s+$//g;
+
+return $mac
+	if ($mac =~ /^(?:[0-9a-f]{2}:){5}[0-9a-f]{2}$/);
+
+return "";
+}
