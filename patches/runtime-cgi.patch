+# print_free_addresses()
+# Shows DHCPv4 pool addresses that are not reserved and have no active lease.
+# Expired ordinary dynamic leases are considered available again.
+sub print_free_addresses
+{
+my $ver = 4;
+
+my (undef, $root, undef, $err) = &kea_read_dhcp_config($ver);
+my ($current, $lerr) = &kea_current_leases($ver);
+my $reservations = &kea_runtime_all_reservations($ver);
+
+print &ui_subheading(&text('comp_dhcp'.$ver));
+
+if ($err || $lerr) {
+	print &ui_alert_box(
+		&html_escape($err || $lerr),
+		"warning", undef, undef, "");
+	return;
+	}
+
+my %reserved;
+foreach my $r (@$reservations) {
+	my $addr = &kea_runtime_reservation_address($r);
+	$reserved{$addr} = 1 if ($addr);
+	}
+
+my %active;
+my %inactive;
+
+foreach my $lease (@$current) {
+	my $addr = &kea_lease_address($lease);
+	next if (!$addr);
+
+	if (&kea_lease_is_active($lease)) {
+		$active{$addr} = $lease;
+		}
+	else {
+		$inactive{$addr} = $lease;
+		}
+	}
+
+my @free;
+
+foreach my $entry (&kea_all_subnets($root, 4)) {
+	my $subnet = $entry->{'subnet'};
+	my $sid = $subnet->{'id'} || "";
+
+	next if (ref($subnet->{'pools'}) ne 'ARRAY');
+
+	foreach my $pool (@{$subnet->{'pools'}}) {
+		my $range = $pool->{'pool'} || "";
+		next if ($range !~ /^\s*(\d+\.\d+\.\d+\.\d+)\s*-\s*(\d+\.\d+\.\d+\.\d+)\s*$/);
+
+		my $start = &kea_runtime_ipv4_to_int($1);
+		my $end = &kea_runtime_ipv4_to_int($2);
+
+		next if (!defined($start) || !defined($end) || $end < $start);
+
+		for (my $n = $start; $n <= $end; $n++) {
+			my $ip = &kea_runtime_int_to_ipv4($n);
+
+			next if ($reserved{$ip});
+			next if ($active{$ip});
+
+			my $old = $inactive{$ip};
+
+			push(@free, {
+				'address' => $ip,
+				'id' => $sid,
+				'identifier' => $old ?
+					&kea_lease_identifier($old) : "",
+				'hostname' => $old ?
+					($old->{'hostname'} || "") : "",
+				'note' => $old ?
+					"Free - previous lease inactive" :
+					"Free",
+				});
+			}
+		}
+	}
+
+@free = sort {
+	&kea_runtime_ip_compare($a->{'address'}, $b->{'address'})
+	} @free;
+
+print &ui_div("Addresses in configured DHCPv4 pools that are not reserved and do not have an active lease.");
+
+print &ui_columns_start([
+	"Address",
+	"ID",
+	"Previous identifier",
+	"Previous hostname",
+	"Status",
+	], 100);
+
+foreach my $row (@free) {
+	print &ui_columns_row([
+		&html_escape($row->{'address'}),
+		&html_escape($row->{'id'}),
+		&html_escape($row->{'identifier'}),
+		&html_escape($row->{'hostname'}),
+		&html_escape($row->{'note'}),
+		]);
+	}
+
 print &ui_columns_end();
 }
 
