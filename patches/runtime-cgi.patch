+# ASUS client metadata imported from the router ClientList CSV.
+# This is display-only metadata; nothing is written back to Kea.
+our $kea_runtime_asus_metadata_cache;
+
+sub kea_runtime_asus_metadata
+{
+return $kea_runtime_asus_metadata_cache
+	if (ref($kea_runtime_asus_metadata_cache) eq 'HASH');
+
+my $file = "/etc/webmin/kea-dhcp/asus-clients.json";
+my %data;
+
+if (-r $file) {
+	eval {
+		require JSON::PP;
+
+		local $/;
+		open(my $fh, "<", $file) or die $!;
+		my $json = <$fh>;
+		close($fh);
+
+		my $decoded = JSON::PP->new->utf8->decode($json);
+
+		if (ref($decoded) eq 'HASH') {
+			foreach my $mac (keys %$decoded) {
+				my $key = lc($mac || "");
+				$key =~ s/^\s+|\s+$//g;
+				$data{$key} = $decoded->{$mac}
+					if ($key ne '');
+				}
+			}
+		};
+	}
+
+$kea_runtime_asus_metadata_cache = \%data;
+return $kea_runtime_asus_metadata_cache;
+}
