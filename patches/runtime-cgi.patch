+# kea_runtime_ipv4_to_int(address)
+sub kea_runtime_ipv4_to_int
+{
+my ($ip) = @_;
+
+my @p = split(/\./, $ip || "");
+return undef if (@p != 4);
+return undef if (grep { $_ !~ /^\d+$/ || $_ < 0 || $_ > 255 } @p);
+
+return ($p[0] << 24) +
+       ($p[1] << 16) +
+       ($p[2] << 8) +
+       $p[3];
+}
+
+# kea_runtime_int_to_ipv4(integer)
+sub kea_runtime_int_to_ipv4
+{
+my ($n) = @_;
+
+return join(".",
+	($n >> 24) & 255,
+	($n >> 16) & 255,
+	($n >> 8) & 255,
+	$n & 255);
+}
