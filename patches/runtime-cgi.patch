+# kea_runtime_neighbor_map()
+# Reads the kernel IPv4 neighbor table once per page request.
+# This is passive presence information; it does not actively probe clients.
+sub kea_runtime_neighbor_map
+{
+my %map;
+
+my $cmd = "/usr/sbin/ip neigh show dev eth0 2>/dev/null";
+
+if (open(my $fh, "-|", "/bin/sh", "-c", $cmd)) {
+	while (my $line = <$fh>) {
+		chomp($line);
+
+		my ($ip) = $line =~ /^(\d+\.\d+\.\d+\.\d+)/;
+		next if (!$ip);
+
+		my ($state) = $line =~
+			/\b(REACHABLE|STALE|DELAY|PROBE|FAILED|INCOMPLETE|PERMANENT|NOARP)\b/;
+
+		next if (!$state);
+
+		if ($state eq "REACHABLE" ||
+		    $state eq "DELAY" ||
+		    $state eq "PROBE" ||
+		    $state eq "PERMANENT" ||
+		    $state eq "NOARP") {
+			$map{$ip} = "Online";
+			}
+		elsif ($state eq "STALE") {
+			$map{$ip} = "Recently seen";
+			}
+		else {
+			$map{$ip} = "Not currently seen";
+			}
+		}
+
+	close($fh);
+	}
+
+return \%map;
+}
+
+# kea_runtime_presence(address, map)
+sub kea_runtime_presence
+{
+my ($addr, $map) = @_;
+
+return "Not currently seen"
+	if (!$addr || ref($map) ne "HASH");
+
+return $map->{$addr} || "Not currently seen";
+}
