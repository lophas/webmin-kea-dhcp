+&print_lease_error_notice($err);
+return if ($err);
+
+my %rows;
+
+# Reservation hostnames are administrator-defined names, so they take
+# precedence over DHCP-supplied and ASUS-discovered client names.
+my %reservation_hostname;
+
+foreach my $r (@$reservations) {
+	my $ip = &kea_runtime_reservation_address($r);
+	next if (!$ip);
+
+	my $hostname = $r->{'hostname'} || "";
+	next if ($hostname eq "");
+
+	my $identifier = lc(&kea_runtime_reservation_identifier($r) || "");
+	$identifier =~ s/^\s+|\s+$//g;
+
+	if ($identifier ne "") {
+		$reservation_hostname{"id|".$ip."|".$identifier} = $hostname;
+		}
+
+	# Fallback for non-MAC reservation identifier types.
+	$reservation_hostname{"ip|".$ip} = $hostname;
+	}
+
+# Current lease records first.
 foreach my $lease (@$leases) {
+	my $addr = &kea_lease_address($lease);
+	next if (!$addr);
+
+	my $active = &kea_lease_is_active($lease);
+
+	my $identifier = &kea_lease_identifier($lease);
+
+	my $lookup_id = lc($identifier || "");
+	$lookup_id =~ s/^\s+|\s+$//g;
+
+	my $reservation_name =
+		$reservation_hostname{"id|".$addr."|".$lookup_id} ||
+		$reservation_hostname{"ip|".$addr} ||
+		"";
+
+	my $hostname = $reservation_name ne "" ?
+		$reservation_name :
+		&kea_runtime_display_hostname(
+			$lease->{'hostname'} || "", $identifier);
+
+	$rows{$addr} = {
+		'address' => $addr,
+		'id' => $lease->{'subnet_id'} || $lease->{'subnet-id'} || "",
+		'identifier' => $identifier,
+		'hostname' => $hostname,
+		'device' => &kea_runtime_device_vendor($identifier),
+		'type' => &kea_runtime_lease_type($lease, $reserved_map, $ver),
+		'status' => $active ? "Active" : "Inactive",
+		'expires' => &kea_lease_expires($lease),
+		};
+	}
+
+# Add reservations which currently have no lease record.
+foreach my $r (@$reservations) {
+	my $addr = &kea_runtime_reservation_address($r);
+	next if (!$addr);
+
+	if (!$rows{$addr}) {
+		my $identifier = &kea_runtime_reservation_identifier($r);
+		my $hostname = &kea_runtime_display_hostname(
+			$r->{'hostname'} || "", $identifier);
+
+		$rows{$addr} = {
+			'address' => $addr,
+			'id' => $r->{'_subnet_id'} || "",
+			'identifier' => $identifier,
+			'hostname' => $hostname,
+			'device' => &kea_runtime_device_vendor($identifier),
+			'type' => "Reserved",
+			'status' => "No lease",
+			'expires' => "",
+			};
+		}
+	}
+
+my @rows = sort {
+	&kea_runtime_ip_compare($a->{'address'}, $b->{'address'})
+	} values %rows;
+
+print &ui_columns_start([
+	"Address",
+	"ID",
+	"Identifier",
+	"Hostname",
+	"Device / Vendor",
+	"Type",
+	"Lease status",
